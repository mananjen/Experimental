# IDE and editor state
.vs/
.vscode/
.idea/
*.tmp
*.swp
*~

# Unity-generated crash and profiling data
sysinfo.txt
crashlytics-build.properties
mono_crash.*

# Unity Asset Store tools
/game/Assets/AssetStoreTools*

# Visual Studio cache generated inside Assets
/game/Assets/Plugins/Editor/JetBrains*

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local environment files and logs
.env
.env.*
!.env.example
*.log
